# Gmail account that sends verification emails (currently happyprogramming.us@gmail.com)
MAIL_USERNAME=
# A Gmail App Password (Google Account > Security > 2-Step Verification > App Passwords)
# NOT your regular Gmail password - Gmail blocks plain-password SMTP login.
MAIL_PASSWORD=

# Shared secret the frontend must send as the X-API-Key header.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
MAIL_API_KEY=

# Allowed CORS origin for the frontend calling this API
FRONTEND_ORIGIN=https://happyresearch.org
